# Server
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sample_name
DB_USER=username
DB_PASSWORD=your_postgres_password

# JWT Secrets
# Use long, random strings in production (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_strong_secret_key
JWT_REFRESH_SECRET=replace_with_another_strong_secret_key

# Token Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
